{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:assembleRelease" 
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL":"https://byteblog-app-server-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
